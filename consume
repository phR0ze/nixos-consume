#! /usr/bin/env bash

# consume: convert a running non NixOS Linux into a NixOS in place, by kexec-ing into an ephemeral
# NixOS installer that formats the existing root partition and runs a normal, unattended
# `nixos-install` onto it.
#
# Phases (see the matching section headers below, and the bottom of this file):
#   1. Inspect the running host and validate prerequisites (disk space, RAM, block devices,
#      network, existing swap, SSH keys)
#   2. Print a summary of what was found and confirm with the operator
#   3. Create temporary swap headroom for the `nix build` steps that follow
#   4. Render the target system's NixOS configuration
#   5. Install the Nix package manager onto the running host, then evaluate the rendered
#      target configuration to catch a broken NIXOS_CONFIG/NIXOS_FLAKE early
#   6. Build an ephemeral kexec installer embedding that target configuration
#   7. kexec into it - the point of no return; it formats the root partition and runs
#      `nixos-install` unattended, rebooting into the finished NixOS system on success
#
# More info at: https://github.com/phR0ze/nixos-consume

set -e -o pipefail

NIXPKGS="${NIXPKGS:-nixos-25.11}"
kexecDir=/etc/consume/kexec
targetDir=/etc/consume/target

# See README's Disk space / RAM prerequisites - a 10G disk has been observed to run out of
# space mid-build, and RAM below 2G risks the kexec_load/kexec_file_load failures documented
# there.
minFreeGB=8
minRamMB=2048

# Global state gathered during Phase 1 and consumed by the Phase 4 config renderers:
#   hostName      target hostname
#   rootfsdev     block device backing /
#   rootfstype    filesystem type of rootfsdev
#   esp, bootFs   (EFI only) ESP device and its mount point
#   grubdev       (BIOS only) disk to install GRUB to
#   zramswap      whether to enable zramSwap.enable on the target
#   swapcfg       Nix swapDevices literal: an existing real swap device carried over, or (by
#                 default, unless FALLBACK_SWAP=n) a fallback swapfile added for zram-only targets
#   keys          harvested SSH authorized_keys, one "type key comment" per line

### Small predicates and helpers ##############################################################

isX86_64() {
  [[ "$(uname -m)" == "x86_64" ]]
}

isEFI() {
  [[ -d /sys/firmware/efi ]]
}

# Resolves the whole disk backing $1 (a root filesystem partition, e.g. /dev/vda2) - the
# device GRUB needs to be installed to. Falls back to $1 itself if it's already a whole disk
# (no parent, e.g. an unpartitioned root). Errors out on a root spanning multiple physical
# disks (e.g. LVM/mdadm striped across disks) rather than silently guessing one, since
# consume only supports the single-disk KVM/QEMU targets it's actually been tested against.
findGrubDevice() {
  local -a pknames
  readarray -t pknames < <(lsblk -no pkname "$1" 2>/dev/null | sort -u)
  if [[ ${#pknames[@]} -gt 1 ]]; then
    echo "ERROR: $1 spans multiple disks (${pknames[*]}); consume only supports a single-disk root and refuses to guess which one to install GRUB to." >&2
    return 1
  fi
  [[ -n "${pknames[0]}" ]] && echo "/dev/${pknames[0]}" || echo "$1"
}

findESP() {
  local d esp=""
  for d in /boot/EFI /boot/efi /boot; do
    [[ ! -d "$d" ]] && continue
    [[ "$d" == "$(df "$d" --output=target | sed 1d)" ]] \
      && esp="$(df "$d" --output=source | sed 1d)" \
      && break
  done
  [[ -z "$esp" ]] && { echo "WARNING: No ESP mount point found"; return 1; }
  local uuid
  for uuid in /dev/disk/by-uuid/*; do
    [[ "$(readlink -f "$uuid")" == "$esp" ]] && echo "$uuid" && return 0
  done
}

deriveStateVersion() {
  if [[ "$NIXPKGS" =~ ^nixos-([0-9]{2}\.[0-9]{2})$ ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo "25.11"
  fi
}

# When SERIAL_CONSOLE is set, emits a boot.kernelParams line enabling serial console output
# (console=ttyS0) alongside the normal virtual console. Useful when a display/SSH-based
# console isn't showing anything (e.g. a hung/broken boot) and you need to fall back to
# reading the hypervisor's serial socket directly, as a last-resort debugging aid.
serialKernelParamsNix() {
  [[ "$SERIAL_CONSOLE" == "y" ]] && echo '  boot.kernelParams = [ "console=tty1" "console=ttyS0,115200" ];'
}

# Sysctl + OOM-daemon tuning paired with zramSwap for constrained-RAM targets: swappiness=100
# because swapping into zram is nearly as cheap as RAM; watermark_scale_factor wakes kswapd
# earlier to reclaim proactively; min_free_kbytes raises the safety headroom above the ~5-8MB
# the kernel auto-computes on a 2GB box. systemd.oomd's root/user slices are opt-in even though
# the daemon itself defaults on, so enabling them is what actually activates OOM protection.
memoryTuningNix() {
  [[ "$MEM_TUNING" == "n" ]] && return
  cat << 'EOF'
  boot.kernel.sysctl = {
    "vm.swappiness" = 100;
    "vm.vfs_cache_pressure" = 50;
    "vm.min_free_kbytes" = 16384;
    "vm.watermark_boost_factor" = 0;
    "vm.watermark_scale_factor" = 125;
  };
  systemd.oomd = {
    enableRootSlice = true;
    enableUserSlices = true;
  };
EOF
}

primaryInterface() {
  ip address show | awk -F': ' '/^2:/{print $2}'
}

# True if $1's global-scope IPv4 address was assigned dynamically (DHCP) rather than
# statically configured - the kernel marks DHCP-leased addresses with a "dynamic" flag in
# `ip addr show` output, which static netplan/interfaces config never sets.
interfaceIsDhcp() {
  ip -o addr show dev "$1" scope global 2>/dev/null | grep -q ' inet .*dynamic'
}

### Phase 1: Inspect the running host #########################################################

checkEnv() {
  [[ "$(whoami)" == "root" ]] || { echo "ERROR: Must run as root"; return 1; }
  isX86_64 || { echo "ERROR: consume only supports x86_64 (uname -m: $(uname -m))"; return 1; }

  # kexec IS required on the host's own PATH: confirmed by testing that the generated
  # kexec-boot script (from `config.system.build.kexecTree`) fails with "kexec not found:
  # please install kexec-tools" without it - it does not bundle its own, unlike the separate
  # `boot.kexec`/`kexec.nix` systemd module which does wrap `path = [ pkgs.kexec-tools ]`.
  local bin missing=()
  local -A binToPkg=(
    [bzcat]=bzip2 [xzcat]=xz-utils [curl]=curl [tar]=tar [kexec]=kexec-tools
  )
  for bin in "${!binToPkg[@]}"; do
    command -v "$bin" >/dev/null || missing+=("${binToPkg[$bin]}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    # -o DPkg::Lock::Timeout waits out cloud-init/unattended-upgrades holding the dpkg lock
    # right after boot, instead of failing the whole run on a transient lock collision.
    apt-get -o DPkg::Lock::Timeout=120 update
    apt-get -o DPkg::Lock::Timeout=120 install -y "${missing[@]}"
  fi

  # Some distros ship ssh host keys with permissions too open for sshd to start
  chmod 600 /etc/ssh/ssh_host_*_key 2>/dev/null || true
}

prepareEnv() {
  rootfsdev=$(findmnt -no SOURCE /)
  rootfstype=$(findmnt -no FSTYPE /)

  # $esp/$bootFs (EFI) or $grubdev (BIOS) are used when rendering hardware-configuration.nix
  if isEFI; then
    esp="$(findESP)"
    if mount | grep -q /boot/efi; then
      bootFs=/boot/efi
    elif mount | grep -q /boot/EFI; then
      bootFs=/boot/EFI
    else
      bootFs=/boot
    fi
  else
    grubdev="$(findGrubDevice "$rootfsdev")"
  fi

  export USER="root"
  export HOME="/root"

  hostName=$(hostname -s)

  # shellcheck disable=SC2174
  mkdir -p -m 0755 /nix
}

# Cheap structural sanity checks that don't depend on installNix/buildKexecTree - run these
# right after prepareEnv so a bad state fails in seconds, not after several minutes of `nix
# build`. checkKexecTree (Phase 6) covers what can only be checked after that build.
checkBootDevices() {
  [[ -b "$rootfsdev" ]] || { echo "ERROR: $rootfsdev is not a block device"; return 1; }
  if isEFI; then
    [[ -n "$esp" && -b "$esp" ]] || { echo "ERROR: ESP device not found"; return 1; }
  fi
}

checkDiskSpace() {
  # Measured in exact 1K blocks rather than `df -BG` (which rounds UP to the nearest GB, so
  # e.g. 7.05G actual free would misreport as "8G" and pass a naive >= comparison).
  local availKB minFreeKB
  availKB=$(df --output=avail -k "$rootfsdev" | sed 1d | tr -dc '0-9')
  minFreeKB=$((minFreeGB * 1024 * 1024))
  [[ "$availKB" -ge "$minFreeKB" ]] \
    || { echo "ERROR: only $((availKB / 1024 / 1024))G free on $rootfsdev; consume needs at least ${minFreeGB}G free for the nix build (see README's Disk space prerequisite)."; return 1; }
}

# Soft check only - 2G RAM is the documented minimum and is already what both test VMs run
# with successfully, so this warns rather than aborting.
checkRam() {
  local ramMB
  ramMB=$(free -m | awk '/^Mem:/{print $2}')
  [[ "$ramMB" -ge "$minRamMB" ]] \
    || echo "WARNING: only ${ramMB}MB RAM detected; consume is tested down to ${minRamMB}MB (see README's RAM prerequisite) - the kexec jump may fail below that."
}

# Auto-enables STATIC_IP when the primary interface's address looks statically configured
# (no DHCP), rather than requiring the operator to notice and set it manually. An explicit
# STATIC_IP setting always wins over this detection.
autoDetectNetConf() {
  [[ "$STATIC_IP" == "y" ]] && return
  local iface
  iface=$(primaryInterface)
  [[ -z "$iface" ]] && return
  interfaceIsDhcp "$iface" || STATIC_IP=y
}

checkExistingSwap() {
  local swapShow
  swapShow=$(swapon --show --noheadings --raw)
  zramswap=true
  swapcfg=""
  if [[ -n "$swapShow" ]]; then
    swapDevice="${swapShow%% *}"
    if [[ "$swapDevice" == "/dev/"* ]]; then
      # Only a real block device survives the target root partition being reformatted in
      # phase 6 (a swapfile living on that same partition won't) - persist it into the
      # target's hardware-configuration.nix.
      zramswap=false
      swapcfg="swapDevices = [ { device = \"${swapDevice}\"; } ];"
    fi
  fi

  # zram-only is risky under memory pressure (zram competes with the RAM it's protecting, and
  # there's no disk to overflow into before OOM-killer). Whenever the target is still going to
  # run zram-only (no real swap device was carried over above), add a small disk-backed
  # swapfile as a lower-priority fallback (see README's RAM section). NixOS auto-creates the
  # file on activation via the `size` attribute; no manual mkdir/fallocate needed here.
  if [[ "$zramswap" == "true" && "$FALLBACK_SWAP" != "n" ]]; then
    swapcfg="swapDevices = [ { device = \"/var/swapfile\"; size = 2048; priority = 5; } ];"
  fi
}

# Harvests SSH authorized_keys from /root/.ssh/authorized_keys on the running foreign OS.
# Used both for the ephemeral kexec installer's root access and the final target system.
# Comment and blank lines are dropped up front rather than relying on OpenSSH to ignore a
# stray "#..." string that would otherwise pass through into the rendered Nix key list.
harvestSshKeys() {
  local path="/root/.ssh/authorized_keys" keys=""
  [[ -r "$path" ]] \
    && keys=$(sed -E \
      -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
      -e 's/^[^#].*[[:space:]]((sk-ssh|sk-ecdsa|ssh|ecdsa)-[^[:space:]]+)[[:space:]]+([^[:space:]]+)([[:space:]]*.*)$/\1 \3\4/' \
      "$path")
  echo "$keys"
}

### Phase 2: Summarize & confirm ##############################################################

# Prints a quickemu-style summary of everything consume has gathered about the host and
# what it's about to do, so the operator can sanity-check it before anything destructive
# happens (the swapfile/nix-install/kexec-tree build steps that follow this are all still
# safely reversible - the point of no return is triggerKexec).
printSystemSummary() {
  local osPretty kernelVer cpuModel cpuCores ramTotal diskSize bootLine swapLine keysCount iface netMode

  osPretty=$(. /etc/os-release; echo "$PRETTY_NAME")
  kernelVer=$(uname -r)
  cpuModel=$(grep -m1 '^model name' /proc/cpuinfo | sed 's/^model name[[:space:]]*:[[:space:]]*//')
  cpuCores=$(nproc)
  ramTotal=$(free -h --si | awk '/^Mem:/{print $2}')
  diskSize=$(lsblk -no SIZE "$rootfsdev" 2>/dev/null | head -1 | xargs)

  if isEFI; then
    bootLine="EFI, ESP $esp mounted at $bootFs"
  else
    bootLine="BIOS (legacy), GRUB device $grubdev"
  fi

  local fallbackNote=""
  [[ "$zramswap" == "true" && "$FALLBACK_SWAP" != "n" ]] \
    && fallbackNote=" + fallback swapfile (2G @ /var/swapfile, low priority)"

  if [[ "$zramswap" == "false" ]]; then
    swapLine="existing device $swapDevice carried over (zramSwap disabled on target); temporary 1G swapfile for the build (removed afterward)"
  else
    swapLine="temporary 1G swapfile for the build (removed afterward); target uses zramSwap$fallbackNote"
  fi

  keysCount=$([[ -z "$keys" ]] && echo 0 || wc -l <<< "$keys")
  iface=$(primaryInterface)
  netMode="DHCP"
  [[ "$STATIC_IP" == "y" ]] && netMode="Static"

  cat << EOF

consume - convert this host to NixOS in place
 - Host:      $hostName ($osPretty, Linux $kernelVer)
 - CPU:       ${cpuModel:-unknown}, $cpuCores core(s)
 - RAM:       $ramTotal
 - Disk:      $rootfsdev ($diskSize, $rootfstype)
 - Boot:      $bootLine
 - Network:   ${iface:-unknown} ($netMode)
 - Swap:      $swapLine
 - SSH keys:  $keysCount authorized key(s) from /root/.ssh/authorized_keys carried over
 - NixOS:     $NIXPKGS (system.stateVersion $(deriveStateVersion))
 - Options:   STATIC_IP=${STATIC_IP:-auto} FALLBACK_SWAP=${FALLBACK_SWAP:-y} MEM_TUNING=${MEM_TUNING:-y} KEXEC=${KEXEC:-y} SERIAL_CONSOLE=${SERIAL_CONSOLE:-n}

EOF
}

# Prompts the operator to confirm before proceeding, unless UNATTENDED=y is set.
# Reads from /dev/tty rather than stdin: when run as `curl ... | bash`, stdin is the
# script source itself (already at EOF by the time we get here), not the terminal.
confirmProceed() {
  [[ "$UNATTENDED" == "y" ]] && return 0
  local reply
  read -r -p "This will DESTROY the above disk and replace it with NixOS. Continue? [y/N] " reply < /dev/tty
  [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }
}

### Phase 3: Build headroom ####################################################################

makeSwap() {
  swapFile=$(mktemp /tmp/consume.XXXXX.swp)
  dd if=/dev/zero "of=$swapFile" bs=1M count=$((1 * 1024))
  chmod 0600 "$swapFile"
  mkswap "$swapFile"
  swapon -v "$swapFile"
  swapMade=y
}

removeSwap() {
  swapoff -a
  rm -vf /tmp/consume.*.swp
  swapMade=""
}

# Safety net for `set -e` aborting mid-build (e.g. installNix/buildKexecTree hitting a
# network hiccup): without this, a failure between makeSwap and removeSwap leaves the
# temporary swapfile active and on disk instead of getting cleaned up. Never fires after a
# successful triggerKexec, since `exec` replaces the process rather than exiting normally.
cleanupSwapOnExit() {
  [[ "$swapMade" == "y" ]] && removeSwap
}

### Phase 4: Render the target NixOS configuration #############################################

# Renders a `keys` string (one "type key comment" per line) as a Nix list literal body.
renderAuthorizedKeysNix() {
  local keys="$1" line trimmed_line
  while read -r line; do
    [[ -z "$line" ]] && continue
    line=$(echo -n "$line" | sed 's/\r//g')
    trimmed_line=$(echo -n "$line" | xargs)
    echo -n "''$trimmed_line'' "
  done <<< "$keys"
}

renderConfigurationNix() {
  local network_import=""
  [[ "$STATIC_IP" == "y" ]] && network_import="./networking.nix"
  cat << EOF
{ ... }: {
  imports = [
    ./hardware-configuration.nix
    $network_import
  ];

  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  nix.channel.enable = false;
  nix.nixPath = [ "nixpkgs=flake:nixpkgs" ];
  boot.tmp.cleanOnBoot = true;
$(serialKernelParamsNix)
  zramSwap = { enable = ${zramswap}; algorithm = "zstd"; memoryPercent = 50; priority = 100; };
$(memoryTuningNix)
  networking.hostName = "$hostName";
  networking.domain = "$(hostname -d)";
  services.openssh.enable = true;
  users.users.root.openssh.authorizedKeys.keys = [ $(renderAuthorizedKeysNix "$keys") ];
  system.stateVersion = "$(deriveStateVersion)";
}
EOF
}

renderHardwareConfigNix() {
  local bootcfg
  if isEFI; then
    bootcfg=$(cat << EOF
  boot.loader = {
    efi.efiSysMountPoint = "$bootFs";
    grub = {
      efiSupport = true;
      efiInstallAsRemovable = true;
      device = "nodev";
    };
  };
  fileSystems."$bootFs" = { device = "$esp"; fsType = "vfat"; };
EOF
)
  else
    bootcfg="  boot.loader.grub.device = \"$grubdev\";"
  fi

  cat << EOF
{ modulesPath, ... }:
{
  imports = [ (modulesPath + "/profiles/qemu-guest.nix") ];
$bootcfg
  fileSystems."/" = { device = "$rootfsdev"; fsType = "$rootfstype"; };
  $swapcfg
}
EOF
}

# $1: hostname to use for the nixosConfigurations attribute
renderFlakeNix() {
  local flakeHostName="$1"
  cat << EOF
{
  description = "NixOS configuration generated by consume";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/$NIXPKGS";

  outputs = { self, nixpkgs }: {
    nixosConfigurations."$flakeHostName" = nixpkgs.lib.nixosSystem {
      system = "$(uname -m)-linux";
      modules = [ ./configuration.nix ];
    };
  };
}
EOF
}

renderNetworkingConf() {
  local iface gateway4 gateway6 etherAddr usePredictable
  local -a ipv4Addrs ipv6Addrs nameservers

  iface=$(primaryInterface)
  readarray -t ipv4Addrs < <(ip address show dev "$iface" | grep 'inet ' | sed -r 's|.*inet ([0-9.]+)/([0-9]+).*|{ address="\1"; prefixLength=\2; }|')
  readarray -t ipv6Addrs < <(ip address show dev "$iface" | grep 'inet6 ' | sed -r 's|.*inet6 ([0-9a-f:]+)/([0-9]+).*|{ address="\1"; prefixLength=\2; }|')
  gateway4=$(ip route show dev "$iface" | grep default | sed -r 's|default via ([0-9.]+).*|\1|')
  gateway6=$(ip -6 route show dev "$iface" | grep default | sed -r 's|default via ([0-9a-f:]+).*|\1|' || true)
  etherAddr=$(ip address show dev "$iface" | grep link/ether | sed -r 's|.*link/ether ([0-9a-f:]+) .*|\1|')

  readarray -t nameservers < <(grep ^nameserver /etc/resolv.conf | sed -r \
    -e 's/^nameserver[[:space:]]+([0-9.a-fA-F:]+).*/"\1"/' \
    -e 's/127[0-9.]+/1.1.1.1/' \
    -e 's/::1/1.1.1.1/')

  usePredictable=true
  [[ "$iface" == eth* ]] && usePredictable=false

  # An empty string is not a valid route/gateway address - omit these entirely rather than
  # emit a bogus defaultGateway6/ipv6.routes entry when the host has no IPv6 default route
  # (the common case on VPS hosts without IPv6), which would otherwise fail at network
  # activation on the target's first boot.
  local gateway6Cfg="" ipv6RoutesCfg="ipv6.routes = [ ];"
  if [[ -n "$gateway6" ]]; then
    gateway6Cfg="defaultGateway6 = { address = \"${gateway6}\"; interface = \"${iface}\"; };"
    ipv6RoutesCfg="ipv6.routes = [ { address = \"${gateway6}\"; prefixLength = 128; } ];"
  fi

  cat << EOF
{ lib, ... }: {
  # This file was populated at runtime with the networking
  # details gathered from the active system.
  networking = {
    nameservers = [ ${nameservers[@]} ];
    defaultGateway = "${gateway4}";
    $gateway6Cfg
    dhcpcd.enable = false;
    usePredictableInterfaceNames = lib.mkForce $usePredictable;
    interfaces = {
      $iface = {
        ipv4.addresses = [$(printf '\n          %s' "${ipv4Addrs[@]}")
        ];
        ipv6.addresses = [$(printf '\n          %s' "${ipv6Addrs[@]}")
        ];
        ipv4.routes = [ { address = "${gateway4}"; prefixLength = 32; } ];
        $ipv6RoutesCfg
      };
    };
  };
  services.udev.extraRules = ''
    ATTR{address}=="${etherAddr}", NAME="${iface}"
  '';
}
EOF
}

# Writes the final target system's configuration.nix/hardware-configuration.nix/flake.nix
# (and networking.nix if STATIC_IP is set) to $targetDir, on the CURRENT root filesystem.
# These get tar+base64-embedded into the ephemeral kexec environment in buildKexecTree, so
# they survive the target partition being reformatted in Phase 6.
makeTargetConfig() {
  mkdir -p "$targetDir"
  renderHardwareConfigNix > "$targetDir/hardware-configuration.nix"
  [[ "$STATIC_IP" == "y" ]] && renderNetworkingConf > "$targetDir/networking.nix"

  if [[ $NIXOS_FLAKE = http* ]]; then
    curl -L "$NIXOS_FLAKE" -o "$targetDir/flake.nix"
  else
    renderFlakeNix "$hostName" > "$targetDir/flake.nix"
  fi

  if [[ $NIXOS_CONFIG = http* ]]; then
    curl -L "$NIXOS_CONFIG" -o "$targetDir/configuration.nix"
  else
    renderConfigurationNix > "$targetDir/configuration.nix"
  fi
}

### Phase 5: Install the Nix package manager ###################################################

installNix() {
  groupadd nixbld -g 30000 || true
  for i in {1..10}; do
    useradd -c "Nix build user $i" -d /var/empty -g nixbld -G nixbld -M -N -r -s "$(command -v nologin)" "nixbld$i" || true
  done
  NIX_INSTALL_URL="${NIX_INSTALL_URL:-https://nixos.org/nix/install}"
  curl -L "${NIX_INSTALL_URL}" | sh -s -- --no-channel-add

  # shellcheck disable=SC1090
  source ~/.nix-profile/etc/profile.d/nix.sh
}

### Phase 6: Build the ephemeral kexec installer ###############################################

# Evaluates the target's own flake - the one embedded into the ephemeral installer and later
# built by `nixos-install --flake` inside it - before anything destructive happens. Catches a
# broken NIXOS_CONFIG/NIXOS_FLAKE override (or a renderer bug) while the original OS is still
# intact, rather than discovering it only after the target partition has been formatted.
validateTargetConfig() {
  nix eval --extra-experimental-features 'nix-command flakes' --raw \
    "path:$targetDir#nixosConfigurations.\"$hostName\".config.system.build.toplevel.drvPath" \
    >/dev/null \
    || { echo "ERROR: target configuration in $targetDir failed to evaluate; aborting before touching the disk."; return 1; }
}

# Builds an ephemeral NixOS "installer" system (netboot-minimal.nix + our SSH keys + a
# oneshot unit that formats $rootfsdev, unpacks the target config from makeTargetConfig, and
# runs nixos-install unattended) into a kexec tree at $kexecDir/result.
#
# netboot-minimal.nix (not netboot-base.nix) is used deliberately: netboot-base.nix bundles a
# full offline nixpkgs channel copy, which pushes the kexec payload well over 1GB - large
# enough to make the actual `kexec_load`/`kexec_file_load` syscalls fail or crash outright on
# a 1-2GB RAM VPS (confirmed on a 2GB test VM: kexec_load returned EINVAL, and
# kexec_file_load triggered a kernel page fault). netboot-minimal keeps the payload small
# enough to load reliably, at the cost of needing working network access immediately after
# the kexec jump for `nixos-install` to fetch packages (see STATIC_IP if that's not DHCP).
buildKexecTree() {
  mkdir -p "$kexecDir"

  local targetTarB64
  targetTarB64=$(tar -C "$targetDir" -czf - . | base64 -w0)

  local espMountCmds=""
  if isEFI; then
    espMountCmds="mkdir -p /mnt$bootFs && mount $esp /mnt$bootFs && find /mnt$bootFs -mindepth 1 -exec rm -rf {} +"
  fi

  local mkfsCmd
  case "$rootfstype" in
    ext4 | ext3 | ext2) mkfsCmd="mkfs.$rootfstype -F $rootfsdev" ;;
    xfs) mkfsCmd="mkfs.xfs -f $rootfsdev" ;;
    *) mkfsCmd="mkfs -t $rootfstype $rootfsdev" ;;
  esac

  local network_import=""
  if [[ "$STATIC_IP" == "y" ]]; then
    cp "$targetDir/networking.nix" "$kexecDir/networking.nix"
    network_import="./networking.nix"
  fi

  cat > "$kexecDir/configuration.nix" << EOF
{ modulesPath, pkgs, ... }:
{
  imports = [
    (modulesPath + "/installer/netboot/netboot-minimal.nix")
    $network_import
  ];

$(serialKernelParamsNix)
  networking.hostName = "$hostName-installer";
  zramSwap.enable = true;
  services.openssh.enable = true;
  users.users.root.openssh.authorizedKeys.keys = [ $(renderAuthorizedKeysNix "$keys") ];

  environment.etc."consume-target.tar.gz.b64".text = "$targetTarB64";

  systemd.services.consume-install = {
    description = "consume: install NixOS onto $rootfsdev";
    wantedBy = [ "multi-user.target" ];
    after = [ "network-online.target" ];
    wants = [ "network-online.target" ];
    # nixos-install-tools provides nixos-install itself; git and nix are needed because
    # nixos-install shells out to both (git for the --flake source, nix to build/activate
    # the system) - neither is implicitly on PATH under netboot-minimal.nix.
    path = [ pkgs.gnutar pkgs.gzip pkgs.coreutils pkgs.util-linux pkgs.e2fsprogs pkgs.nixos-install-tools pkgs.git pkgs.nix ];
    serviceConfig = {
      Type = "oneshot";
      StandardOutput = "journal+console";
      StandardError = "journal+console";
    };
    script = ''
      set -euo pipefail
      mkdir -p /mnt
      $mkfsCmd
      mount $rootfsdev /mnt
      $espMountCmds
      mkdir -p /mnt/etc/nixos
      base64 -d /etc/consume-target.tar.gz.b64 | tar -xzf - -C /mnt/etc/nixos

      # Flakes require their source to be git-tracked (even untracked-but-added is fine) -
      # without this, nixos-install writing flake.lock into this same directory mid-eval
      # changes its own content hash out from under itself, causing a NAR hash mismatch.
      git -C /mnt/etc/nixos init -q
      git -C /mnt/etc/nixos add -A

      nixos-install --root /mnt --no-root-passwd --no-channel-copy --flake "/mnt/etc/nixos#$hostName"
      systemctl reboot
    '';
  };
}
EOF

  renderFlakeNix "$hostName-installer" > "$kexecDir/flake.nix"

  nix build --extra-experimental-features 'nix-command flakes' \
    "path:$kexecDir#nixosConfigurations.\"$hostName-installer\".config.system.build.kexecTree" \
    -o "$kexecDir/result"
}

checkKexecTree() {
  [[ -x "$kexecDir/result/kexec-boot" ]] || { echo "ERROR: kexec-boot script not found after build"; return 1; }

  # A kexec payload approaching available RAM has previously crashed kexec_file_load outright
  # (kernel page fault) rather than failing gracefully - see buildKexecTree's netboot-minimal
  # comment for the prior incident. netboot-minimal.nix normally keeps this well under RAM;
  # guard against a regression back into that failure mode rather than relying on it never
  # recurring. -L dereferences kexecDir/result, which is a symlink to the actual store path.
  local payloadMB ramMB
  payloadMB=$(($(du -sbL "$kexecDir/result" | awk '{print $1}') / 1024 / 1024))
  ramMB=$(free -m | awk '/^Mem:/{print $2}')
  if ((payloadMB * 2 > ramMB)); then
    echo "ERROR: kexec payload (${payloadMB}MB) is too large relative to RAM (${ramMB}MB); kexec_load/kexec_file_load has been observed to crash outright rather than fail gracefully in this situation. Increase RAM, or investigate why the payload grew."
    return 1
  fi
}

### Phase 7: Point of no return #################################################################

# kexec kills this bash process's entire process tree and jumps straight into the ephemeral
# NixOS installer. Nothing after this line ever runs.
triggerKexec() {
  echo "About to kexec into the NixOS installer."
  echo "Your SSH session will drop now; reconnect with the same key once the installer's sshd comes up to watch progress (journalctl -u consume-install -f)."
  exec "$kexecDir/result/kexec-boot"
}

### Main #########################################################################################

trap cleanupSwapOnExit EXIT

checkEnv
prepareEnv
checkBootDevices
checkDiskSpace
checkRam
autoDetectNetConf
checkExistingSwap

keys=$(harvestSshKeys)
[[ -z "$keys" ]] && { echo "ERROR: No SSH authorized_keys found on this host; refusing to continue (this would lock you out of the installed system)."; exit 1; }

printSystemSummary
confirmProceed

makeSwap # headroom for `nix build` on small instances

makeTargetConfig
installNix
validateTargetConfig
buildKexecTree
checkKexecTree

removeSwap

if [[ "$KEXEC" != "n" ]]; then
  triggerKexec
else
  echo "KEXEC=n set; generated configs are in $targetDir and $kexecDir. Run $kexecDir/result/kexec-boot manually to proceed."
fi
